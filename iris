import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.datasets import load_iris
from sklearn.preprocessing import LabelEncoder


iris = sns.load_dataset("iris")

print("Dataset Loaded Successfully\n")


print("First 5 Rows")
print(iris.head())

print("\nLast 5 Rows")
print(iris.tail())

print("\nShape")
print(iris.shape)

print("\nColumns")
print(iris.columns)

print("\nInfo")
print(iris.info())

print("\nStatistical Summary")
print(iris.describe())



print("\nMissing Values")
print(iris.isnull().sum())


print("\nDuplicate Rows")
print(iris.duplicated().sum())


print("\nSpecies Count")
print(iris["species"].value_counts())


le = LabelEncoder()

iris["species_encoded"] = le.fit_transform(
    iris["species"]
)

print("\nEncoded Species")
print(iris[["species","species_encoded"]].head())


plt.figure(figsize=(6,4))

sns.histplot(
    iris["sepal_length"],
    kde=True
)

plt.title("Histogram")
plt.show()



plt.figure(figsize=(6,4))

sns.boxplot(
    y=iris["sepal_length"]
)

plt.title("Box Plot")
plt.show()


plt.figure(figsize=(6,4))

sns.countplot(
    x="species",
    data=iris
)

plt.title("Count Plot")
plt.show()


iris["species"].value_counts().plot(
    kind="pie",
    autopct="%1.1f%%"
)

plt.title("Species Distribution")
plt.ylabel("")
plt.show()

plt.figure(figsize=(6,4))

sns.scatterplot(
    x="sepal_length",
    y="sepal_width",
    hue="species",
    data=iris
)

plt.title("Scatter Plot")
plt.show()

sns.pairplot(
    iris,
    hue="species"
)

plt.show()

print("\nCorrelation Matrix")

numeric_data = iris.select_dtypes(include=np.number)

print(numeric_data.corr())


plt.figure(figsize=(8,6))

sns.heatmap(
    numeric_data.corr(),
    annot=True,
    cmap="coolwarm"
)

plt.title("Correlation Heatmap")
plt.show()


fig, axes = plt.subplots(2,2,
                         figsize=(12,8))

sns.boxplot(
    x="species",
    y="sepal_length",
    data=iris,
    ax=axes[0,0]
)

sns.boxplot(
    x="species",
    y="sepal_width",
    data=iris,
    ax=axes[0,1]
)

sns.boxplot(
    x="species",
    y="petal_length",
    data=iris,
    ax=axes[1,0]
)

sns.boxplot(
    x="species",
    y="petal_width",
    data=iris,
    ax=axes[1,1]
)

plt.tight_layout()
plt.show()


plt.figure(figsize=(8,5))

sns.violinplot(
    x="species",
    y="petal_length",
    data=iris
)

plt.title("Violin Plot")
plt.show()


from pandas.plotting import andrews_curves

plt.figure(figsize=(10,6))

andrews_curves(
    iris,
    "species"
)

plt.title("Andrews Curves")
plt.show()

from pandas.plotting import parallel_coordinates

plt.figure(figsize=(10,6))

parallel_coordinates(
    iris,
    "species"
)

plt.title("Parallel Coordinates")
plt.show()


print("\nEDA COMPLETED")
print("Key Insights:")
print("- Check distributions using Histograms")
print("- Check outliers using Boxplots")
print("- Check class balance using Countplot")
print("- Check relationships using Scatterplots")
print("- Check all relationships using Pairplot")
print("- Check correlations using Heatmap")
print("- Check feature separation using Violin/Boxplots")
